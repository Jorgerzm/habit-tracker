#!/bin/sh
# Maven Wrapper script
set -e

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep -E '^distributionUrl=' "$MAVEN_WRAPPER_PROPERTIES" | sed 's/distributionUrl=//')
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_DISTRIBUTION_URL="${DISTRIBUTION_URL}"

# Find or download Maven
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/$(basename "$MAVEN_DISTRIBUTION_URL" .zip)"

if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  tmpFile=$(mktemp)
  if command -v curl > /dev/null; then
    curl -sL "$MAVEN_DISTRIBUTION_URL" -o "$tmpFile"
  elif command -v wget > /dev/null; then
    wget -q "$MAVEN_DISTRIBUTION_URL" -O "$tmpFile"
  fi
  unzip -qq "$tmpFile" -d "$MAVEN_HOME" 2>/dev/null
  rm -f "$tmpFile"
  MAVEN_HOME="$MAVEN_HOME/$(ls "$MAVEN_HOME")"
fi

if [ -z "$MAVEN_HOME" ]; then
  # Fallback to system Maven
  exec mvn "$@"
else
  exec "$MAVEN_HOME/bin/mvn" "$@"
fi
